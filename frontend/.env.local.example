# Local development:
NEXT_PUBLIC_API_BASE_URL=/backend-api
BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# Production recommendation:
# Keep NEXT_PUBLIC_API_BASE_URL=/backend-api and point BACKEND_INTERNAL_URL
# at the internal Symfony upstream behind your reverse proxy or private network.
# Example:
# NEXT_PUBLIC_API_BASE_URL=/backend-api
# BACKEND_INTERNAL_URL=http://backend:8000
