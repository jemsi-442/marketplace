{
  "name": "marketplace-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbo": "next dev",
    "dev:light": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "clean:cache": "rm -rf .next",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "build:e2e:prod": "PLAYWRIGHT_BUILD_SKIP_TYPECHECK=1 PLAYWRIGHT_BUILD_SINGLE_WORKER=1 npm run build",
    "test:e2e:prod": "npm run build:e2e:prod && playwright test -c playwright.prod.config.ts",
    "test:e2e:prod:auth": "npm run build:e2e:prod && playwright test -c playwright.prod.config.ts tests/e2e/authenticated-smoke.spec.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.90.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.544.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.62.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.11",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.35.0",
    "eslint-config-next": "^16.0.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2"
  }
}
