# ==============================
# Application Environment
# ==============================
APP_ENV=prod
APP_DEBUG=0
APP_SECRET=replace_with_generated_app_secret
APP_RUNTIME_ENV=production
APP_TIMEZONE=UTC

DEFAULT_URI=https://marketplace.example.com
APP_SHARE_DIR=var/share

LOG_LEVEL=warning
SENTRY_DSN=

# ==============================
# Database Configuration
# ==============================
DATABASE_URL="mysql://marketplace_user:replace_db_password@127.0.0.1:3306/marketplace?serverVersion=mariadb-11.8.5&charset=utf8mb4"

DATABASE_MAX_CONNECTIONS=20
DATABASE_CONNECT_TIMEOUT=5

# ==============================
# Redis
# ==============================
REDIS_URL=redis://127.0.0.1:6379
CACHE_TTL=3600
RATE_LIMIT_STORAGE=redis

# ==============================
# Mailer Configuration
# ==============================
MAILER_DSN=smtp://SMTP_USER:SMTP_PASS@smtp.provider.com:587?encryption=tls&auth_mode=login
MAILER_FROM=noreply@marketplace.example.com

# ==============================
# JWT
# ==============================
JWT_PRIVATE_KEY_PATH=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY_PATH=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=replace_with_strong_passphrase
JWT_TTL=900
JWT_REFRESH_TTL=2592000
JWT_ISSUER=marketplace-api
JWT_AUDIENCE=marketplace-client

# ==============================
# Security Controls
# ==============================
LOGIN_MAX_ATTEMPTS=5
ACCOUNT_LOCK_DURATION=900
ENABLE_2FA=true
CSRF_PROTECTION=true
STRICT_TRANSPORT_SECURITY=true
SYMFONY_TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR
SYMFONY_TRUSTED_HOSTS=^marketplace\\.example\\.com$|^www\\.marketplace\\.example\\.com$
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SAMESITE=strict

# ==============================
# Social Login / OAuth
# ==============================
FRONTEND_PUBLIC_URL=https://marketplace.example.com
OAUTH_PUBLIC_API_BASE_URL=https://marketplace.example.com/backend-api
OAUTH_STATE_TTL=600
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# ==============================
# Payments / Escrow
# ==============================
ESCROW_AUTO_RELEASE_ENABLED=true
ESCROW_RELEASE_DELAY_SECONDS=86400
MAX_TRANSACTION_AMOUNT_MINOR=100000000
MIN_TRANSACTION_AMOUNT_MINOR=100

# ==============================
# Fraud / Risk Engine
# ==============================
FRAUD_RISK_THRESHOLD_HIGH=60
FRAUD_RISK_THRESHOLD_CRITICAL=40
ENABLE_GEOIP_CHECK=true
ENABLE_DEVICE_FINGERPRINT=true

# ==============================
# Snippe Mobile Money Gateway
# ==============================
SNIPPE_API_KEY=replace_with_provider_key
SNIPPE_BASE_URL=https://api.snippe.africa/v1
SNIPPE_WEBHOOK_SECRET=replace_with_webhook_secret

# ==============================
# Delivery Attachments
# ==============================
DELIVERY_UPLOAD_DIR=
DELIVERY_UPLOAD_PUBLIC_PREFIX=
